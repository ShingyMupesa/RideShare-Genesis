VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

# Set to "native" only when building for the Cloudflare Workers deployment
# (worker/) — selects the raw-WebSocket transport instead of socket.io-client.
# Leave unset for the Node/Express + Socket.IO backend (default).
VITE_WS_MODE=
