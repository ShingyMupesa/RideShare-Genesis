# Copy to keystore.properties (git-ignored) and fill in the real values.
# The release signing keystore itself is never committed to this repo — it
# was generated once and sent to you directly; store it somewhere durable
# and private (a password manager's file storage, an encrypted drive).
# Losing it means you can never publish an update to an app that's already
# live on the Play Store under this package ID — there is no recovery.
storeFile=../android.keystore
storePassword=REPLACE_ME
keyAlias=ridesharegenesis
keyPassword=REPLACE_ME
