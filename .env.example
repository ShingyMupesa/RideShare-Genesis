# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Database (SQLite file path, created automatically)
DATABASE_FILE=./data/rideshare-genesis.sqlite

# AI Gateway / Decision DNA + Genesis Assistant
# Optional: if set, the AI Gateway will use the Anthropic API to enrich
# Decision DNA narratives and the Genesis Assistant's answers.
# If left empty, Genesis falls back to deterministic, fully-explainable
# rule-based narratives (no external calls, no key required).
ANTHROPIC_API_KEY=

# Payments (mock provider for V1 - sandbox mode only)
PAYMENTS_MODE=sandbox
