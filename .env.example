# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Auth
# Required. The server refuses to start if this is unset — there is no
# insecure default. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Database (SQLite file path, created automatically)
DATABASE_FILE=./data/rideshare-genesis.sqlite

# AI Gateway / Decision DNA + Genesis Assistant
# Optional: if set, the AI Gateway will use the Anthropic API to enrich
# Decision DNA narratives and the Genesis Assistant's answers.
# If left empty, Genesis falls back to deterministic, fully-explainable
# rule-based narratives (no external calls, no key required).
ANTHROPIC_API_KEY=

# Payments (mock provider for V1 - sandbox mode only)
PAYMENTS_MODE=sandbox

# Platform commission, as a percent (e.g. 10 = 10%). Kept at 0 for the
# early-bird period; the rate actually charged is stored per-payment, so
# raising this later only affects payments made after the change.
PLATFORM_COMMISSION_PCT=0

# Stripe (optional — enables a real "Card (Stripe)" payment option alongside
# the sandbox providers above). Both keys must be from the same mode (test
# or live) or Stripe will reject every request. The publishable key is not
# secret by Stripe's own design and is safe to commit; the secret key is
# not — set it in a real, gitignored .env file, never here.
STRIPE_PUBLISHABLE_KEY=pk_test_51U3eBgAinwPSkE66HuIIknHlHgDp5qulB9MilDNO6cMSbcw3bZNlpDQBiVmdNrUVhWObJq8qWAOvSS85bLjHXjm600ICmVfmsJ
STRIPE_SECRET_KEY=

# Email (optional — enables real "forgot password" emails via Resend).
# Without this set, a reset link is still generated but only logged to the
# server console (see forgot-password in src/users/routes.js) — nothing
# breaks, "forgot password" just isn't self-service yet.
RESEND_API_KEY=
# Resend's shared onboarding@resend.dev sender works without verifying a
# domain, but delivery is more restricted than a verified sender — verify
# your own domain in Resend for reliable delivery to real users.
EMAIL_FROM=RideShare Genesis <onboarding@resend.dev>
