# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Auth
# Required. The server refuses to start if this is unset — there is no
# insecure default. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Database (SQLite file path, created automatically)
DATABASE_FILE=./data/rideshare-genesis.sqlite

# AI Gateway / Decision DNA + Genesis Assistant
# Optional: if set, the AI Gateway will use the Anthropic API to enrich
# Decision DNA narratives and the Genesis Assistant's answers.
# If left empty, Genesis falls back to deterministic, fully-explainable
# rule-based narratives (no external calls, no key required).
ANTHROPIC_API_KEY=

# Payments (mock provider for V1 - sandbox mode only)
PAYMENTS_MODE=sandbox

# Platform commission, as a percent (e.g. 10 = 10%). Kept at 0 for the
# early-bird period; the rate actually charged is stored per-payment, so
# raising this later only affects payments made after the change.
PLATFORM_COMMISSION_PCT=0

# Stripe (optional — enables a real "Card (Stripe)" payment option alongside
# the sandbox providers above). Both keys must be from the same mode (test
# or live) or Stripe will reject every request. The publishable key is not
# secret by Stripe's own design and is safe to commit; the secret key is
# not — set it in a real, gitignored .env file, never here.
STRIPE_PUBLISHABLE_KEY=pk_test_51U3eBgAinwPSkE66HuIIknHlHgDp5qulB9MilDNO6cMSbcw3bZNlpDQBiVmdNrUVhWObJq8qWAOvSS85bLjHXjm600ICmVfmsJ
STRIPE_SECRET_KEY=

# Email (optional — enables real "forgot password" emails via Resend).
# Without this set, a reset link is still generated but only logged to the
# server console (see forgot-password in src/users/routes.js) — nothing
# breaks, "forgot password" just isn't self-service yet.
RESEND_API_KEY=
# Resend's shared onboarding@resend.dev sender works without verifying a
# domain, but delivery is more restricted than a verified sender — verify
# your own domain in Resend for reliable delivery to real users.
EMAIL_FROM=RideShare Genesis <onboarding@resend.dev>

# Push notifications (optional — enables real browser push for new matches,
# messages and booking updates via src/push/. Without these set, subscribing
# just silently no-ops server-side; nothing breaks). VAPID_PUBLIC_KEY is not
# secret and is safe to commit/expose client-side; VAPID_PRIVATE_KEY_JWK is a
# secret and must never be committed. Generate a pair with:
#   node -e "crypto.subtle.generateKey({name:'ECDSA',namedCurve:'P-256'},true,['sign','verify']).then(async k=>{const pub=new Uint8Array(await crypto.subtle.exportKey('raw',k.publicKey));const b64url=b=>btoa(String.fromCharCode(...b)).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');console.log('VAPID_PUBLIC_KEY='+b64url(pub));console.log('VAPID_PRIVATE_KEY_JWK='+JSON.stringify(await crypto.subtle.exportKey('jwk',k.privateKey)))})"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_JWK=
VAPID_SUBJECT=mailto:mupesashingy@gmail.com

# M-Pesa (optional — enables a real "M-Pesa" payment option via Safaricom's
# Daraja API, see src/payments/mpesa.js. Without these set, /payments/methods
# reports mpesa as disabled and the frontend hides the option; nothing else
# breaks). M-Pesa only ever moves Kenyan shillings — this option is only
# offered on bookings priced in KES.
#
# Get sandbox credentials free at https://developer.safaricom.co.ke (create
# an app under "My Apps", then add the sandbox "Lipa Na M-Pesa Online"
# product to it for the shortcode/passkey). Safaricom publishes a shared
# sandbox test shortcode (174379) and passkey on that same site — use those
# for MPESA_SHORTCODE/MPESA_PASSKEY while MPESA_ENV=sandbox; go to
# https://developer.safaricom.co.ke/documentation for the go-live checklist
# to get real (production) credentials, which requires a registered Kenyan
# business.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# sandbox | production — always start with sandbox
MPESA_ENV=sandbox
# Safaricom needs a real, publicly reachable HTTPS URL to send the payment
# callback to — never localhost. Leave unset to fall back to the request's
# own Host header (fine once actually deployed); set explicitly if this
# process sits behind a proxy/tunnel (e.g. ngrok) where that header isn't
# the public one, such as testing locally.
MPESA_CALLBACK_BASE_URL=
